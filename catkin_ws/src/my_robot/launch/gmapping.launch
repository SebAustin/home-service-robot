<?xml version="1.0"?>
<!--
  SLAM: slam_gmapping builds the Map from the Hokuyo /scan and wheel odometry, and publishes
  map -> odom. The map frame starts at the robot's Start Pose. Start world.launch first.
-->
<launch>
  <node name="slam_gmapping" pkg="gmapping" type="slam_gmapping" output="screen">
    <remap from="scan" to="/scan"/>

    <!-- Frames: same chain amcl uses, map -> odom -> robot_footprint -->
    <param name="base_frame" value="robot_footprint"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_frame" value="map"/>

    <!-- Map: 5 cm cells, sized for the 8 x 6 m building with margin -->
    <param name="delta" value="0.05"/>
    <param name="xmin" value="-6.0"/>
    <param name="ymin" value="-5.0"/>
    <param name="xmax" value="6.0"/>
    <param name="ymax" value="5.0"/>
    <param name="map_update_interval" value="2.0"/>

    <!-- Laser: the building is at most ~9 m across, so cap usable range well below the 30 m sensor max -->
    <param name="maxUrange" value="8.0"/>
    <param name="maxRange" value="10.0"/>

    <!-- Odometry: Gazebo's diff drive is near ground truth, so expect little motion noise -->
    <param name="srr" value="0.01"/>
    <param name="srt" value="0.02"/>
    <param name="str" value="0.01"/>
    <param name="stt" value="0.02"/>

    <!-- Update after 20 cm or ~11 degrees of motion; 80 particles is plenty indoors -->
    <param name="linearUpdate" value="0.2"/>
    <param name="angularUpdate" value="0.2"/>
    <param name="particles" value="80"/>
    <param name="transform_publish_period" value="0.05"/>
  </node>
</launch>
